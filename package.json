{
  "name": "car-utils",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix server install && node scripts/car-utils.mjs install",
    "car": "node --no-warnings scripts/car-utils.mjs",
    "app": "node --no-warnings scripts/car-utils.mjs launch",
    "app:restart": "npm run build && npm --prefix server run build && node --no-warnings scripts/car-utils.mjs restart",
    "app:status": "node --no-warnings scripts/car-utils.mjs status",
    "serve": "npm run build && npm --prefix server run build && PORT=4173 node --no-warnings server/dist/index.js",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "deploy:cloudbase": "npm run build && npx --yes -p @cloudbase/cli tcb hosting deploy dist -e car-utils-sync-d8gc5l3xlb8350cdf",
    "docker:up": "docker compose --profile desktop up -d --build --wait",
    "docker:stop": "docker compose --profile desktop stop",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix server test",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^2.27.1",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
