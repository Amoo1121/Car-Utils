# Vite development server port.
CAR_UTILS_WEB_PORT=5173

# Background production app port used by start-car-utils.command.
CAR_UTILS_APP_PORT=4173

# Port exposed by Docker on this Mac and used by the Vite /api proxy.
CAR_UTILS_API_PORT=3001

# Port used inside the backend container. Usually this does not need to change.
CAR_UTILS_API_INTERNAL_PORT=3001

# Authentication sessions last 30 days by default. Use true only behind HTTPS.
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=false

# Optional server-side secret mixed into password derivation. Keep it private and stable.
AUTH_PASSWORD_PEPPER=
